{
  "info": {
    "name": "BFF (bff-nextjs)",
    "description": "Backend-for-Frontend over two free public APIs (DummyJSON as \"Employees\", JSONPlaceholder as \"Tasks\"). No auth required. Import this collection + the BFF (local) environment, then run any request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "GET /api/employees (list)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?limit=10&skip=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees"],
              "query": [
                { "key": "limit", "value": "10" },
                { "key": "skip", "value": "0" }
              ]
            },
            "description": "Supports ?limit, ?skip, ?search (search runs against DummyJSON's /users/search instead)."
          }
        },
        {
          "name": "GET /api/employees (search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?search=emily",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees"],
              "query": [{ "key": "search", "value": "emily" }]
            }
          }
        },
        {
          "name": "GET /api/employees/:id (detail + task counts)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees", "{{employeeId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "GET /api/tasks (all)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "GET /api/tasks (by employee, pending only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks?employeeId={{employeeId}}&completed=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "employeeId", "value": "{{employeeId}}" },
                { "key": "completed", "value": "false" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard (BFF aggregation)",
      "item": [
        {
          "name": "GET /api/dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dashboard"]
            },
            "description": "Combines employeeService + taskService in parallel into totals + a busiest-employees leaderboard."
          }
        }
      ]
    }
  ]
}
